{
  "name": "github-action-traceability",
  "description": "Ensures pull requests are linked to a Linear issue",
  "version": "1.0.0",
  "author": "Neo4j",
  "license": "Apache-2.0",
  "main": "dist/index.js",
  "homepage": "https://github.com/neo-technology/github-action-traceability#readme",
  "files": [
    "action.yml",
    "dist",
    "lib"
  ],
  "scripts": {
    "clean": "rm -rf dist lib",
    "format": "prettier --write '**/*.ts'",
    "lint": "eslint **/*.ts",
    "compile": "tsc",
    "test": "jest",
    "build": "ncc build src/index.ts --license licenses.txt",
    "package": "yarn clean && yarn format && yarn lint && yarn compile && yarn test && yarn build"
  },
  "repository": {
    "type": "git",
    "url": "https://github.com/neo-technology/github-action-traceability"
  },
  "bugs": {
    "url": "https://github.com/neo-technology/github-action-traceability/issues"
  },
  "dependencies": {
    "@actions/core": "^1.5.0",
    "@actions/github": "^6",
    "@linear/sdk": "^83.0.0",
    "eslint-plugin-prettier": "^4.2.1",
    "graphql": "^16"
  },
  "devDependencies": {
    "@jest/globals": "^29.7",
    "@types/jest": "^29.5",
    "@types/node": "^20",
    "@typescript-eslint/eslint-plugin": "^7",
    "@typescript-eslint/parser": "^7",
    "@vercel/ncc": "^0.38",
    "eslint": "^8.57",
    "eslint-config-prettier": "^9",
    "eslint-plugin-jest": "^28",
    "eslint-plugin-promise": "^6",
    "jest": "^29.7",
    "prettier": "^2.8",
    "ts-jest": "^29.2",
    "typescript": "^5"
  },
  "resolutions": {
    "@babel/traverse": "^7.23.2",
    "braces": "^3.0.3",
    "flatted": "^3.4.2",
    "js-yaml": "^3.14.2",
    "json5": "^2.2.3",
    "minimatch": "^3.1.3",
    "picomatch": "^2.3.2"
  }
}
